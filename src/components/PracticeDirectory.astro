---
import { practices as cards } from '../data/practices';

const row1 = cards.slice(0, 4);
const row2 = cards.slice(4);
---

<section id="practices" class="w-full py-[100px]" style="background-color: #F5F1EA;">
  <div class="section-container">
    <div class="text-center mb-14">
      <h2 class="font-montserrat font-bold leading-tight mb-4" style="font-size: 40px; color: #4E5854; font-variant: small-caps;">Practice Directory</h2>
      <div class="flex justify-center mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="208" height="28" viewBox="0 0 208 28" fill="none" aria-hidden="true">
          <g clip-path="url(#clip0_practice_directory)">
            <path d="M117.338 14.0294L104.309 1L91.2797 14.0294L104.309 27.0588L117.338 14.0294Z" stroke="#796D56" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M113.948 14.0295L104.309 4.39062L94.6702 14.0295L104.309 23.6683L113.948 14.0295Z" fill="#766B53"/>
            <path d="M3 14L74 14" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M134 13H205" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
          </g>
          <defs>
            <clipPath id="clip0_practice_directory">
              <rect width="208" height="28" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      </div>
      <h3 class="font-montserrat text-[24px] font-semibold leading-[28.8px] mb-5" style="color: #2A2A2A;">Our Expertise</h3>
      <p class="font-merriweather text-[18px] font-normal leading-[30.6px] max-w-[860px] mx-auto" style="color: #2A2A2A;">Our practice areas form a complete end-to-end capability system that give our clients a comprehensive partner equipped to guide the entire lifecycle of modern digital work.</p>
    </div>

    <div class="practice-desktop-content">
    <!-- Row 1: 4 cards -->
    <div class="mx-auto grid max-w-[1216px] grid-cols-1 items-start gap-8 mb-8 sm:grid-cols-2 lg:grid-cols-4">
      {row1.map((card) => (
        <article class={`practice-card practice-card-desktop ${card.expandOnHover ? 'practice-card-expandable' : ''} self-start flex min-h-[296px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)] transition-all duration-700 hover:shadow-[0_12px_28px_-4px_rgba(0,0,0,0.15)]`}>
          <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center">
              <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
            <h4 class="mb-3 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">
              <a href="#expertise" class="practice-title-link" data-expertise-tab={card.tabId}>{card.title}</a>
            </h4>
            <div class="practice-card-body-stack">
              {card.description && (
                <p class="practice-card-description font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
              )}
              {card.capabilities && (
                <ul class="practice-hover-capabilities">
                  {card.capabilities.map((item, capabilityIndex) => (
                    <li>
                      <a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[capabilityIndex] ?? item}>{item}</a>
                      {capabilityIndex === 0 && card.subCapabilities.length > 0 && (
                        <ul class="practice-sub-capabilities">{card.subCapabilities.map(sub => <li><a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[0]}>{sub}</a></li>)}</ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Row 2: 4 cards -->
    <div class="mx-auto grid max-w-[1216px] grid-cols-1 items-start gap-8 mb-14 sm:grid-cols-2 lg:grid-cols-4">
      {row2.map((card) => (
        <article class={`practice-card practice-card-desktop ${card.expandOnHover ? 'practice-card-expandable' : ''} self-start flex min-h-[296px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)] transition-all duration-700 hover:shadow-[0_12px_28px_-4px_rgba(0,0,0,0.15)]`}>
          <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
            <div class="flex h-10 w-10 items-center justify-center">
              <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
            </div>
            <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
          </div>
          <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
            <h4 class="mb-3 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">
              <a href="#expertise" class="practice-title-link" data-expertise-tab={card.tabId}>{card.title}</a>
            </h4>
            <div class="practice-card-body-stack">
              {card.description && (
                <p class="practice-card-description font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
              )}
              {card.capabilities && (
                <ul class="practice-hover-capabilities">
                  {card.capabilities.map((item, capabilityIndex) => (
                    <li>
                      <a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[capabilityIndex] ?? item}>{item}</a>
                      {capabilityIndex === 0 && card.subCapabilities.length > 0 && (
                        <ul class="practice-sub-capabilities">{card.subCapabilities.map(sub => <li><a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[0]}>{sub}</a></li>)}</ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
    </div>

    <!-- Mobile slider -->
    <div class="practice-mobile-carousel" style="display: none; max-width: 350px; margin: 0 auto 32px;">
      <div class="practice-mobile-controls">
        <button id="practice-mobile-prev" class="practice-mobile-control practice-mobile-control-prev" type="button" aria-label="Previous practice">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="practice-mobile-next" class="practice-mobile-control practice-mobile-control-next" type="button" aria-label="Next practice">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <div style="position: relative; width: 100%; min-height: 228px;">
        {cards.map((card, i) => (
          <article
            class="practice-mobile-card practice-card flex h-full min-h-[228px] flex-col overflow-hidden rounded-t-[8px] bg-white shadow-[0_6px_12px_-2px_rgba(0,0,0,0.09),0_1px_3px_rgba(0,0,0,0.08)]"
            data-mobile-card={i}
            style={`display: ${i === 0 ? 'flex' : 'none'};`}
          >
            <div class="flex h-16 items-center justify-between px-4" style={`background-color: ${card.headerColor};`}>
              <div class="flex h-10 w-10 items-center justify-center">
                <img src={card.iconSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" aria-hidden="true" />
              </div>
              <span class="font-montserrat text-[16px] font-bold leading-6 text-white">{card.num}</span>
            </div>
            <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
              <h4 class="mb-2 font-montserrat text-[16px] font-semibold leading-6" style="color: #060505;">
                <a href="#expertise" class="practice-title-link" data-expertise-tab={card.tabId}>{card.title}</a>
              </h4>
              <div class="practice-card-body-stack">
                {card.description && (
                  <p class="practice-card-description font-merriweather text-[14px] font-normal leading-[23.8px]" style="color: #2A2A2A;">{card.description}</p>
                )}
                {card.capabilities && (
                  <ul class="practice-hover-capabilities">
                    {card.capabilities.map((item, capabilityIndex) => (
                      <li>
                        <a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[capabilityIndex] ?? item}>{item}</a>
                      {capabilityIndex === 0 && card.subCapabilities.length > 0 && (
                        <ul class="practice-sub-capabilities">{card.subCapabilities.map(sub => <li><a href="#expertise" class="practice-capability-link" data-expertise-tab={card.tabId} data-expertise-capability={card.capabilityTargets?.[0]}>{sub}</a></li>)}</ul>
                      )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="text-center">
      <p class="font-merriweather text-[20px] font-normal leading-[28px]" style="color: #2A2A2A;">
        Not sure where to start? Our <a href="#" data-open-ai-concierge class="font-semibold underline" style="color: #683547;">AI Concierge</a> can help you.
      </p>
    </div>
  </div>
</section>

<div class="practice-slide-buffer" aria-hidden="true"></div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(
    '.practice-card-desktop',
    { opacity: 0, y: 24 },
    {
      opacity: 1,
      y: 0,
      duration: 0.9,
      stagger: 0.08,
      ease: 'power2.out',
      scrollTrigger: { trigger: '#practices', start: 'top 80%', once: true },
    },
  );

  const mobileCards = document.querySelectorAll<HTMLElement>('.practice-mobile-card');
  const prevBtn = document.getElementById('practice-mobile-prev');
  const nextBtn = document.getElementById('practice-mobile-next');
  let mobileIndex = 0;

  function showMobileCard(index: number) {
    if (!mobileCards.length) return;
    mobileIndex = ((index % mobileCards.length) + mobileCards.length) % mobileCards.length;
    mobileCards.forEach((card, i) => {
      card.style.display = i === mobileIndex ? 'flex' : 'none';
    });
  }

  prevBtn?.addEventListener('click', () => showMobileCard(mobileIndex - 1));
  nextBtn?.addEventListener('click', () => showMobileCard(mobileIndex + 1));
  showMobileCard(0);

  function scrollToExpertiseCard() {
    const carousel = document.querySelector<HTMLElement>('#expertise .expertise-carousel');
    const expertiseSection = document.getElementById('expertise');
    const target = carousel || expertiseSection;

    if (!target) return;

    const navHeight = document.getElementById('main-nav')?.getBoundingClientRect().height || 0;
    const rect = target.getBoundingClientRect();
    const top = window.scrollY + rect.top - navHeight - 16;

    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLAnchorElement>('.practice-capability-link, .practice-title-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      const expertiseSection = document.getElementById('expertise');
      const tabId = link.dataset.expertiseTab;
      const capability = link.dataset.expertiseCapability;

      if (!expertiseSection || !tabId) return;

      event.preventDefault();

      const showExpertise = (window as any).showExpertiseTab;
      if (showExpertise) {
        showExpertise(tabId, capability);
      } else {
        window.setTimeout(() => {
          const delayedShowExpertise = (window as any).showExpertiseTab;
          if (delayedShowExpertise) delayedShowExpertise(tabId, capability);
        }, 120);
      }

      window.requestAnimationFrame(scrollToExpertiseCard);
      window.history.replaceState(null, '', '#expertise');
    });
  });

  const practicesSection = document.getElementById('practices');
  const expandablePracticeCards = document.querySelectorAll<HTMLElement>('#practices .practice-card-expandable');
  let practiceHoverClearTimer: number | undefined;
  let activePracticeCard: HTMLElement | null = null;
  let latestPracticePointer = { x: -1000, y: -1000 };

  function updatePracticeCardScrollMetrics(card: HTMLElement) {
    const capabilities = card.querySelector<HTMLElement>('.practice-hover-capabilities');
    const description = card.querySelector<HTMLElement>('.practice-card-description');
    if (!capabilities) return;

    const capabilityHeight = Math.ceil(capabilities.scrollHeight);
    const restBodyHeight = Math.ceil(description?.scrollHeight || 0) + 1;
    const hoverBodyHeight = Math.max(capabilityHeight + 10, restBodyHeight);
    card.style.setProperty('--practice-rest-body-height', `${restBodyHeight}px`);
    card.style.setProperty('--practice-capabilities-height', `${capabilityHeight}px`);
    card.style.setProperty('--practice-hover-body-height', `${hoverBodyHeight}px`);
  }

  function resetPracticeCardScroll(card: HTMLElement) {
    const body = card.querySelector<HTMLElement>('.practice-card-body-stack');
    if (body) body.scrollTop = 0;
  }

  function isPointerNearPracticeCard(card: HTMLElement) {
    const rect = card.getBoundingClientRect();
    const buffer = 28;

    return (
      latestPracticePointer.x >= rect.left - buffer &&
      latestPracticePointer.x <= rect.right + buffer &&
      latestPracticePointer.y >= rect.top - buffer &&
      latestPracticePointer.y <= rect.bottom + buffer
    );
  }

  function clearPracticeCardHover(card: HTMLElement) {
    const body = card.querySelector<HTMLElement>('.practice-card-body-stack');

    card.classList.remove('is-practice-card-hovered');

    if (activePracticeCard === card) {
      activePracticeCard = null;
    }

    if (body) {
      body.scrollTop = 0;
    }

    if (!document.querySelector('#practices .practice-card-expandable:hover, #practices .practice-card-expandable.is-practice-card-hovered')) {
      practicesSection?.classList.remove('practice-hover-active');
    }
  }

  expandablePracticeCards.forEach((card) => {
    updatePracticeCardScrollMetrics(card);

    card.addEventListener('pointerenter', () => {
      window.clearTimeout(practiceHoverClearTimer);
      expandablePracticeCards.forEach((otherCard) => {
        if (otherCard !== card) {
          otherCard.classList.remove('is-practice-card-hovered');
        }
      });

      card.classList.add('is-practice-card-hovered');
      activePracticeCard = card;
      practicesSection?.classList.add('practice-hover-active');
      updatePracticeCardScrollMetrics(card);

      window.requestAnimationFrame(() => {
        if (card.classList.contains('is-practice-card-hovered')) {
          resetPracticeCardScroll(card);
        }
      });
    });

    card.addEventListener('pointerleave', () => {
      window.clearTimeout(practiceHoverClearTimer);

      practiceHoverClearTimer = window.setTimeout(() => {
        if (card.matches(':hover') || isPointerNearPracticeCard(card)) return;

        clearPracticeCardHover(card);
      }, 320);
    });
  });

  window.addEventListener('pointermove', (event) => {
    latestPracticePointer = { x: event.clientX, y: event.clientY };

    if (
      activePracticeCard &&
      !activePracticeCard.matches(':hover') &&
      !isPointerNearPracticeCard(activePracticeCard)
    ) {
      window.clearTimeout(practiceHoverClearTimer);
      clearPracticeCardHover(activePracticeCard);
    }
  }, { passive: true });

  window.addEventListener('resize', () => {
    expandablePracticeCards.forEach(updatePracticeCardScrollMetrics);
  });

</script>

<style>
.practice-sub-capabilities { margin: 8px 0 8px 8px; padding: 0; list-style: none; }
.practice-card-body-stack { overflow-anchor: none; }
.practice-card-body-stack {
  min-height: 0;
}

.practice-hover-capabilities {
  list-style: none;
  margin: 0;
  padding: 0;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: none;
  transition: opacity 2.0s ease-in-out;
}

.practice-hover-capabilities li {
  position: relative;
  padding-left: 12px;
  margin-bottom: 4px;
  font-family: 'Merriweather', serif;
  font-size: 14px;
  line-height: 23.8px;
  color: #2A2A2A;
}

.practice-hover-capabilities li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: #8C7860;
}

.practice-capability-link {
  color: inherit;
  display: inline;
  text-decoration: none;
  transition: color 0.2s ease, text-decoration-color 0.2s ease;
}

.practice-title-link {
  align-items: baseline;
  color: inherit;
  display: inline-flex;
  gap: 6px;
  text-decoration: none;
  transition: color 0.2s ease;
}

.practice-title-link::after {
  color: #8C8375;
  content: '→';
  font-size: 0.9em;
  line-height: 1;
  transition: color 0.2s ease;
}

.practice-capability-link:hover,
.practice-capability-link:focus-visible,
.practice-title-link:hover,
.practice-title-link:focus-visible {
  color: #683547;
}

.practice-capability-link:hover,
.practice-capability-link:focus-visible {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.practice-title-link:hover::after,
.practice-title-link:focus-visible::after {
  color: #683547;
}

.practice-capability-link:focus-visible,
.practice-title-link:focus-visible {
  outline: 2px solid rgba(104, 53, 71, 0.35);
  outline-offset: 2px;
  border-radius: 3px;
}

.practice-card-description {
  max-height: none;
  opacity: 1;
  overflow: hidden;
  visibility: visible;
  transition: opacity 0.56s ease, max-height 0.56s ease, margin-bottom 0.56s ease;
}

.practice-mobile-controls {
  display: none;
}

@media (min-width: 769px) {
  #practices {
    padding-bottom: 100px !important;
    overflow: visible;
  }

  #practices.practice-hover-active {
    z-index: 50 !important;
  }

  .practice-slide-buffer {
    height: 260px;
    background-color: #F5F1EA;
  }

  #practices .practice-card-desktop {
    min-height: 340px;
    height: auto;
    transition: transform 0.7s ease, box-shadow 0.7s ease;
  }

  #practices .practice-card-expandable .practice-card-body-stack {
    height: var(--practice-rest-body-height, auto);
    max-height: var(--practice-rest-body-height, none);
    overflow: hidden;
    transition: height 0.7s ease-in-out, max-height 0.7s ease-in-out;
  }

  #practices .practice-card-expandable:hover,
  #practices .practice-card-expandable.is-practice-card-hovered {
    min-height: 0;
    position: relative;
    z-index: 5;
  }

  #practices .practice-card-expandable:hover .practice-card-body-stack,
  #practices .practice-card-expandable.is-practice-card-hovered .practice-card-body-stack {
    height: var(--practice-hover-body-height, 300px);
    max-height: var(--practice-hover-body-height, 300px);
    overflow-y: scroll;
    overscroll-behavior: contain;
    padding-right: 6px;
    scroll-behavior: auto;
    scrollbar-color: #B9AD9E #EFEAE3;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    transition: height 0.7s ease-in-out, max-height 0.7s ease-in-out;
  }

  #practices .practice-card-expandable:hover .practice-card-body-stack::-webkit-scrollbar,
  #practices .practice-card-expandable.is-practice-card-hovered .practice-card-body-stack::-webkit-scrollbar {
    width: 6px;
  }

  #practices .practice-card-expandable:hover .practice-card-body-stack::-webkit-scrollbar-track,
  #practices .practice-card-expandable.is-practice-card-hovered .practice-card-body-stack::-webkit-scrollbar-track {
    background: #EFEAE3;
    border-radius: 999px;
  }

  #practices .practice-card-expandable:hover .practice-card-body-stack::-webkit-scrollbar-thumb,
  #practices .practice-card-expandable.is-practice-card-hovered .practice-card-body-stack::-webkit-scrollbar-thumb {
    background: #B9AD9E;
    border-radius: 999px;
  }

  #practices .practice-card-expandable .practice-hover-capabilities {
    transition: opacity 0.7s ease-in-out;
  }

  #practices .practice-card-expandable .practice-card-description {
    transition: opacity 0.64s ease, max-height 0.82s ease, margin-bottom 0.82s ease;
  }
}

.practice-card-expandable:hover .practice-hover-capabilities,
.practice-card-expandable.is-practice-card-hovered .practice-hover-capabilities {
  max-height: var(--practice-capabilities-height, 720px);
  opacity: 1;
  margin-top: 10px;
  transform: none;
}

.practice-card-expandable:hover .practice-card-description,
.practice-card-expandable.is-practice-card-hovered .practice-card-description {
  opacity: 1;
  max-height: none;
  visibility: visible;
  margin-bottom: 0;
  pointer-events: auto;
}

@media (max-width: 768px) {
  .practice-slide-buffer {
    display: none;
  }

  #practices {
    padding-top: 80px !important;
    padding-bottom: 80px !important;
  }

  #practices .practice-desktop-content {
    display: none;
  }

  #practices .practice-mobile-carousel {
    display: block !important;
    overflow: visible;
    position: relative;
  }

  #practices .practice-mobile-controls {
    display: block;
    inset: 0;
    margin: 0;
    min-height: 0;
    pointer-events: none;
    position: absolute;
    width: auto;
    z-index: 12;
  }

  #practices .practice-mobile-control {
    align-items: center;
    appearance: none;
    background: rgba(255, 255, 255, 0.44);
    border: 1px solid rgba(145, 131, 108, 0.22);
    border-radius: 50%;
    box-shadow: none;
    color: rgba(117, 106, 87, 0.58);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 28px;
    height: 28px;
    justify-content: center;
    line-height: 0;
    margin: 0;
    max-height: 28px;
    max-width: 28px;
    min-height: 28px;
    min-width: 28px;
    padding: 0;
    pointer-events: auto;
    position: absolute;
    top: 246px;
    transform: translateY(-50%);
    transition: color 0.2s ease;
    vertical-align: middle;
    width: 28px;
    -webkit-tap-highlight-color: transparent;
  }

  #practices .practice-mobile-control-prev {
    left: -14px;
  }

  #practices .practice-mobile-control-next {
    right: -14px;
  }

  #practices .practice-mobile-control:hover,
  #practices .practice-mobile-control:focus-visible {
    color: rgba(117, 106, 87, 0.82);
  }

  #practices .practice-mobile-control:active {
    transform: translateY(-50%);
  }

