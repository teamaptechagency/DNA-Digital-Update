---
// Our Difference section — bg white
const differences = [
  {
    id: 'large-firm',
    icon: '/images/icons/icon-large-firm.png',
    title: 'Large Firm Failures, Real World Rescues',
    titleColor: '#6A747D',
    cardBg: '#F1F5F8',
    cardBorder: 'rgba(106, 116, 125, 0.30)',
    dropCap: 'W',
    intro: 'e have a proven track record of stepping in to rescue projects where large consulting firms have failed.',
    body: "Our approach is conservative, pragmatic, and grounded in decades of real systems experience and common sense. We're here to do the job right, not meet billing quotas or chase the latest tech trends so developers can pad their résumés. Our goal is to succeed where others have failed.",
  },
  {
    id: 'enterprise',
    icon: '/images/icons/icon-enterprise.png',
    title: 'Enterprise Expertise, Boutique Agility',
    titleColor: '#887660',
    cardBg: '#F6F4F1',
    cardBorder: 'rgba(136, 118, 96, 0.30)',
    dropCap: 'Y',
    intro: 'ou get the same senior‑level architectural and systems expertise found in the largest consulting firms,',
    body: 'but with the agility, focus, and hands‑on leadership only a boutique consultancy can provide. Our deep systems expertise allows us to identify risks early, eliminate hidden failure points, and avoid the costly mistakes common in over‑engineered consulting engagements. Our goal is to exceed your expectations.',
  },
  {
    id: 'entrepreneurial',
    icon: '/images/icons/icon-entrepreneurial.png',
    title: 'Entrepreneurial Mindset, Applied Discipline',
    titleColor: '#86845E',
    cardBg: '#F0FDE7',
    cardBorder: 'rgba(134, 132, 94, 0.30)',
    dropCap: 'Y',
    intro: 'ou get consistent, senior‑level leadership from start to finish. No layers. No red tape.',
    body: "No inflated teams. Just deep experience applied directly to your most important initiatives. We manage projects as if we're spending our own money and build systems as if our business depends on them. Unlike large organizations, you'll experience no churn. No handoffs. No disappearing act. Our goal is to be your long-term partner.",
  },
];
---

<section id="our-difference" class="w-full py-[100px] bg-white">
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <h2 class="font-montserrat font-bold leading-tight text-black mb-4" style="font-size: 40px; font-variant: small-caps;">Our Difference</h2>

      <div class="flex justify-center mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="208" height="28" viewBox="0 0 208 28" fill="none" aria-hidden="true">
          <g clip-path="url(#clip0_our_difference)">
            <path d="M117.338 14.0294L104.309 1L91.2797 14.0294L104.309 27.0588L117.338 14.0294Z" stroke="#796D56" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M113.948 14.0295L104.309 4.39062L94.6702 14.0295L104.309 23.6683L113.948 14.0295Z" fill="#766B53"/>
            <path d="M3 14L74 14" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
            <path d="M134 13H205" stroke="#796D56" stroke-width="5" stroke-miterlimit="10" stroke-linecap="round"/>
          </g>
          <defs>
            <clipPath id="clip0_our_difference">
              <rect width="208" height="28" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      </div>

      <h3 class="font-montserrat text-[24px] font-semibold leading-[28.8px] text-black mb-6">Where Strategy Meets Technical Precision</h3>
      <div class="difference-intro-wrap mt-5">
        <p class="font-merriweather text-[18px] font-normal leading-[30.6px] text-left" style="color: #2A2A2A; max-width: 535px; margin: 0;">
          We align technology, people, and processes so transformation is no longer a gamble but a guaranteed outcome
        </p>
      </div>
    </div>

    <div class="difference-desktop-content">
    <!-- Difference Cards -->
    <div class="difference-cards grid grid-cols-1 lg:grid-cols-3 gap-6 mb-16">
      {differences.map((diff, i) => (
        <article
          class="difference-card flex flex-col overflow-hidden hover:-translate-y-2 transition-transform duration-300 shadow-sm hover:shadow-lg"
          style={`border-radius: 8px; border: 1px solid ${diff.cardBorder}; background: ${diff.cardBg};`}
        >
          <!-- Icon -->
          <div class="p-8 pb-4 flex justify-center">
            <div class="w-[80px] h-[80px] rounded-full flex items-center justify-center overflow-hidden" style="background-color: #766B58;">
              <img src={diff.icon} alt={diff.title} class="w-[48px] h-[48px] object-contain invert brightness-0 filter" />
            </div>
          </div>

          <!-- Content -->
          <div class="p-8 pt-4 flex-1 flex flex-col">
            <h3
              class="font-montserrat text-[24px] font-semibold leading-[28.8px] text-center mb-6"
              style={`color: ${diff.titleColor};`}
            >
              {diff.id === 'large-firm' ? (
                <>
                  Large Firm Failures,
                  <br />
                  Real World Rescues
                </>
              ) : (
                diff.title
              )}
            </h3>
            <p class="difference-card-copy font-merriweather text-[16px] font-normal leading-[27.2px] text-black flex-1">
              <span class="difference-card-dropcap">{diff.dropCap}</span>{diff.intro} {diff.body}
            </p>
          </div>
        </article>
      ))}
    </div>
    </div>

    <!-- Mobile slider -->
    <div class="difference-mobile-carousel" style="display: none; max-width: 350px; margin: 0 auto 40px;">
      <div style="position: relative; width: 100%; min-height: 496px;">
        {differences.map((diff, i) => (
          <article
            class="difference-mobile-card difference-card flex flex-col overflow-hidden shadow-sm"
            data-mobile-diff={i}
            style={`display: ${i === 0 ? 'flex' : 'none'}; border-radius: 8px; border: 1px solid ${diff.cardBorder}; background: ${diff.cardBg}; min-height: 496px;`}
          >
            <div class="p-6 pb-3 flex justify-center">
              <div class="w-[80px] h-[80px] rounded-full flex items-center justify-center overflow-hidden" style="background-color: #766B58;">
                <img src={diff.icon} alt={diff.title} class="w-[40px] h-[40px] object-contain invert brightness-0 filter" />
              </div>
            </div>

            <div class="px-6 pb-6 pt-3 flex-1 flex flex-col">
              <h3 class="font-montserrat text-[24px] font-semibold leading-[28.8px] text-center mb-4" style={`color: ${diff.titleColor};`}>
                {diff.id === 'large-firm' ? (
                  <>
                    Large Firm Failures,
                    <br />
                    Real World Rescues
                  </>
                ) : (
                  diff.title
                )}
              </h3>
              <p class="difference-card-copy font-merriweather text-[14px] font-normal leading-[22px] text-black flex-1">
                <span class="difference-card-dropcap">{diff.dropCap}</span>{diff.intro} {diff.body}
              </p>
            </div>
          </article>
        ))}
      </div>

      <div class="difference-mobile-controls">
        <button id="difference-mobile-prev" class="difference-mobile-control difference-mobile-control-prev" type="button" aria-label="Previous difference">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="difference-mobile-next" class="difference-mobile-control difference-mobile-control-next" type="button" aria-label="Next difference">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- CTA Row -->
    <div class="text-center">
      <p class="font-merriweather text-[20px] font-medium leading-[28px] mb-6" style="color: #060505;">Ready to solve your digital challenges?</p>
      <a href="#" data-open-conversation class="inline-flex items-center justify-center font-montserrat text-[13px] font-semibold tracking-[0.12em] uppercase text-white px-10 py-[14px] transition-all duration-300 hover:opacity-90" style="background-color: #683547; letter-spacing: 0.12em;">
        Start the Conversation
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    '.difference-card',
    { opacity: 0, y: 60 },
    {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.difference-cards',
        start: 'top 75%',
      }
    }
  );

  const mobileDiffCards = document.querySelectorAll<HTMLElement>('.difference-mobile-card');
  const diffPrevBtn = document.getElementById('difference-mobile-prev');
  const diffNextBtn = document.getElementById('difference-mobile-next');
  let diffIndex = 0;

  function showDifferenceCard(index: number) {
    if (!mobileDiffCards.length) return;
    diffIndex = ((index % mobileDiffCards.length) + mobileDiffCards.length) % mobileDiffCards.length;
    mobileDiffCards.forEach((card, i) => {
      card.style.display = i === diffIndex ? 'flex' : 'none';
    });
  }

  diffPrevBtn?.addEventListener('click', () => showDifferenceCard(diffIndex - 1));
  diffNextBtn?.addEventListener('click', () => showDifferenceCard(diffIndex + 1));
  showDifferenceCard(0);
</script>

<style>
.difference-card-copy {
  display: flow-root;
}

.difference-card-dropcap {
  float: left;
  margin-right: 6px;
  margin-top: 2px;
  color: #6A747D;
  font-family: 'Merriweather', serif;
  font-size: 48px;
  font-style: normal;
  font-weight: 400;
  line-height: 49px;
}

.difference-intro-wrap {
  display: flex;
  justify-content: center;
}

#our-difference {
  overflow: hidden;
}

@media (max-width: 768px) {
  #our-difference {
    padding-top: 80px !important;
    padding-bottom: 80px !important;
  }

  #our-difference .difference-desktop-content {
    display: none;
  }

  #our-difference .difference-mobile-carousel {
    display: block !important;
    overflow: visible;
    position: relative;
  }

  #our-difference .difference-mobile-controls {
    display: block;
    inset: 0;
    margin: 0;
    min-height: 0;
    pointer-events: none;
    position: absolute;
    width: auto;
    z-index: 12;
  }

  #our-difference .difference-mobile-control {
    align-items: center;
    appearance: none;
    background: rgba(255, 255, 255, 0.44);
    border: 1px solid rgba(145, 131, 108, 0.22);
    border-radius: 50%;
    box-shadow: none;
    color: rgba(117, 106, 87, 0.58);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 28px;
    height: 28px;
    justify-content: center;
    line-height: 0;
    margin: 0;
    max-height: 28px;
    max-width: 28px;
    min-height: 28px;
    min-width: 28px;
    padding: 0;
    pointer-events: auto;
    position: absolute;
    top: 248px;
    transform: translateY(-50%);
    transition: color 0.2s ease;
    vertical-align: middle;
    width: 28px;
    -webkit-tap-highlight-color: transparent;
  }

  #our-difference .difference-mobile-control-prev {
    left: -14px;
  }

  #our-difference .difference-mobile-control-next {
    right: -14px;
  }

  #our-difference .difference-mobile-control:hover,
  #our-difference .difference-mobile-control:focus-visible {
    color: rgba(117, 106, 87, 0.82);
  }

  #our-difference .difference-mobile-control:active {
    transform: translateY(-50%);
  }

  #our-difference .difference-mobile-control:focus-visible {
    outline: 1px solid rgba(117, 106, 87, 0.18);
    outline-offset: 2px;
  }

  #our-difference .difference-mobile-control svg {
    display: block;
    flex: 0 0 13px;
    height: 13px;
    pointer-events: none;
    width: 13px;
  }

  #our-difference h2 {
    color: #4E5854 !important;
    font-size: 28px !important;
    line-height: 36px !important;
  }

  #our-difference h3 {
    color: #2A2A2A !important;
    font-size: 18px !important;
    line-height: 28px !important;
  }

  #our-difference .text-center > h3 {
    margin-bottom: 0 !important;
  }

  #our-difference .difference-intro-wrap {
    margin-top: 20px !important;
  }

  #our-difference p.font-merriweather.text-\[18px\] {
    font-size: 17px !important;
    line-height: 29px !important;
    max-width: 700px !important;
  }

  #our-difference .difference-card-dropcap {
    font-size: 34px;
    line-height: 0.66;
    margin-right: 5px;
    margin-top: 8px;
  }

  #our-difference a[href="#contact"] {
    width: 100%;
    max-width: 350px;
    min-height: 52px;
    font-size: 16px !important;
    letter-spacing: 0.08px !important;
  }
}
</style>
