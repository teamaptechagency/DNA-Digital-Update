---
// Nav component — transparent over hero, white on scroll
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 h-[72px] md:h-[112px] flex items-center transition-all duration-500" style="background: rgba(255,255,255,0.10); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
  <div class="section-container w-full flex items-center justify-between">
    <!-- Logo Block -->
    <a href="/" class="flex-shrink-0 flex flex-col items-start">
      <img src="/images/logo.svg" alt="DNA Digital Consultancy" class="h-[38px] md:h-[80px] w-auto" />
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden lg:flex items-center gap-8">
      <a href="/" class="nav-link font-montserrat text-[14px] font-semibold uppercase text-white hover:text-dna-gold-light transition-colors duration-300" style="border-bottom: 2px solid rgba(255,255,255,0.7); padding-bottom: 2px;">Home</a>
      <a href="#practices" class="nav-link font-montserrat text-[14px] font-semibold uppercase text-white hover:text-dna-gold-light transition-colors duration-300 flex items-center gap-1">
        Practices
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
      </a>
      <a href="#products" class="nav-link font-montserrat text-[14px] font-semibold uppercase text-white hover:text-dna-gold-light transition-colors duration-300 flex items-center gap-1">
        Products
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
      </a>
      <a href="/about" class="nav-link font-montserrat text-[14px] font-semibold uppercase text-white hover:text-dna-gold-light transition-colors duration-300">
        About
      </a>
    </div>

    <!-- CTA Button -->
    <button type="button" data-open-conversation class="hidden lg:inline-flex items-center justify-center px-5 py-[11px] font-montserrat text-[14px] font-bold uppercase transition-all duration-300 hover:bg-white/20 flex-shrink-0" style="background: rgba(245,245,245,0.10); color: #E0C9A3; letter-spacing: 0.005em; border-radius: 6px;">
      Start a Conversation
    </button>

    <!-- Mobile Menu Toggle -->
    <button id="mobile-menu-btn" class="lg:hidden text-white p-2" aria-label="Open menu">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden fixed top-[72px] left-0 right-0 z-50 py-8 px-5 flex-col gap-5 shadow-2xl" style="background: #F4F3F2; max-height: calc(100vh - 72px); overflow-y: auto;">
    <a href="/" class="font-montserrat text-[16px] font-bold text-[#5D5749] uppercase tracking-[0.02em] hover:text-[#91836C] transition-colors">Home</a>
    <a href="#practices" class="font-montserrat text-[16px] font-bold text-[#5D5749] uppercase tracking-[0.02em] hover:text-[#91836C] transition-colors">Practices</a>
    <a href="#products" class="font-montserrat text-[16px] font-bold text-[#5D5749] uppercase tracking-[0.02em] hover:text-[#91836C] transition-colors">Products</a>
    <a href="/about" class="font-montserrat text-[16px] font-bold text-[#5D5749] uppercase tracking-[0.02em] hover:text-[#91836C] transition-colors">About</a>
    <button type="button" data-open-conversation class="w-full text-center mt-2 font-montserrat text-[14px] font-semibold uppercase text-white py-4 rounded-[6px]" style="background: #756A57; letter-spacing: 0.02em;">Start a Conversation</button>
  </div>


  <!-- Conversation Form Panel -->
<aside
id="conversation-panel"
class="fixed right-0 top-[72px] md:top-[112px] h-[calc(100vh-72px)] md:h-[calc(100vh-112px)] w-full md:w-[420px] max-w-[420px] translate-x-full opacity-0 pointer-events-none transition-all duration-300 ease-out overflow-hidden"
style="background: rgba(34,37,42,0.42); backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%); box-shadow: -24px 0 60px rgba(0,0,0,0.38);"
aria-hidden="true"
>
<div class="absolute inset-0 z-0" style="background: url('/images/hero-bg.jpg') center/cover no-repeat;"></div>
<div class="absolute inset-0 z-0" style="background: linear-gradient(180deg, rgba(30,33,38,0.78) 0%, rgba(24,27,32,0.62) 62%, rgba(20,23,28,0.48) 100%);"></div>

<div class="conversation-panel-content relative z-10 h-full">
  <button
    id="conversation-close"
    type="button"
    class="conversation-close-btn"
    aria-label="Close conversation form"
  >
    <span class="conversation-close-line conversation-close-line-a"></span>
    <span class="conversation-close-line conversation-close-line-b"></span>
  </button>

  <div class="conversation-title-wrap">
    <h3 class="conversation-title">Thank you for taking the next step</h3>
  </div>

  <!-- GoHighLevel Form -->
  <div class="conversation-ghl-form-wrap">
    <iframe
    src="https://api.leadconnectorhq.com/widget/form/FSDKwUyo2o3zxMkTewfP"
    style="width:100%;height:100%;border:none;border-radius:4px"
    id="inline-FSDKwUyo2o3zxMkTewfP" 
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Form 0"
    data-height="633"
    data-layout-iframe-id="inline-FSDKwUyo2o3zxMkTewfP"
    data-form-id="FSDKwUyo2o3zxMkTewfP"
    title="Form 0"
        >
</iframe>
<script src="https://link.msgsndr.com/js/form_embed.js"></script>
  </div>
</div>
</aside>


  <!-- AI Concierge Chat Panel -->
  <aside
    id="ai-concierge-panel"
    class="fixed right-0 top-[72px] md:top-[112px] h-[calc(100vh-72px)] md:h-[calc(100vh-112px)] w-full md:w-[420px] max-w-[420px] translate-x-full opacity-0 pointer-events-none transition-all duration-300 ease-out overflow-hidden"
    style="background: rgba(34,37,42,0.42); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
    aria-hidden="true"
  >
    <div class="absolute inset-0 z-0" style="background: url('/images/hero-bg.jpg') center/cover no-repeat;"></div>
    <div class="absolute inset-0 z-0" style="background: linear-gradient(180deg, rgba(30,33,38,0.78) 0%, rgba(24,27,32,0.62) 62%, rgba(20,23,28,0.48) 100%);"></div>

    <div class="ai-panel relative z-10 h-full">
      <div class="ai-panel-header">
        <div class="ai-avatar" aria-hidden="true">✦</div>
        <div class="ai-header-text">
          <p class="ai-title">AI Concierge</p>
          <p class="ai-subtitle">Get instant help</p>
        </div>
        <button id="ai-concierge-close" type="button" class="ai-close-btn" aria-label="Close AI concierge chat">
          <span class="ai-close-line ai-close-line-a"></span>
          <span class="ai-close-line ai-close-line-b"></span>
        </button>
      </div>

      <div class="ai-chat-main">
        <div id="ai-chat-thread" class="ai-chat-thread">
          <div class="ai-row ai-row-assistant">
            <div class="ai-avatar" aria-hidden="true">✦</div>
            <div class="ai-bubble ai-bubble-assistant">
              <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s</p>
            </div>
          </div>

          <div class="ai-row ai-row-user">
            <div class="ai-bubble ai-bubble-user">
              <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s</p>
            </div>
          </div>

          <div class="ai-row ai-row-assistant">
            <div class="ai-avatar" aria-hidden="true">✦</div>
            <div class="ai-bubble ai-bubble-assistant">
              <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
            </div>
          </div>
        </div>

        <form id="ai-chat-form" class="ai-input-wrap" action="#" method="post">
          <div class="ai-input-box">
            <input id="ai-chat-input" type="text" placeholder="Write message..." autocomplete="off" />
            <button type="submit" id="ai-send-btn" aria-label="Send message">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.4 12.6L20.6 4.6C21.4 4.2 22.2 5 21.8 5.8L13.8 23C13.4 23.8 12.2 23.7 11.9 22.8L10.2 16.9L4.2 15.2C3.3 14.9 3.2 13.7 4 13.3L9.8 10.3" fill="#A1B1A2"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </aside>
</nav>

<script>
  // Scroll behavior: transparent → white bg
  const nav = document.getElementById('main-nav') as HTMLElement;
  const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const panel = document.getElementById('conversation-panel') as HTMLElement;
  const panelClose = document.getElementById('conversation-close') as HTMLButtonElement;
  const openConversationButtons = document.querySelectorAll('[data-open-conversation]');
  const aiPanel = document.getElementById('ai-concierge-panel') as HTMLElement;
  const aiClose = document.getElementById('ai-concierge-close') as HTMLButtonElement;
  const openAiConciergeButtons = document.querySelectorAll('[data-open-ai-concierge]');
  const aiChatForm = document.getElementById('ai-chat-form') as HTMLFormElement;
  const aiChatInput = document.getElementById('ai-chat-input') as HTMLInputElement;
  const aiChatThread = document.getElementById('ai-chat-thread') as HTMLElement;
  const conversationForm = document.getElementById('conversation-form') as HTMLFormElement;
  const fullNameInput = document.getElementById('conversation-fullname') as HTMLInputElement;
  const contactInput = document.getElementById('conversation-contact') as HTMLInputElement;
  const messageInput = document.getElementById('conversation-message') as HTMLTextAreaElement;
  const methodInputs = document.querySelectorAll('input[name="communication-method"]') as NodeListOf<HTMLInputElement>;
  const submitButton = conversationForm?.querySelector('.conversation-submit-btn') as HTMLButtonElement;

  function setError(field: string, message: string) {
    const errorEl = conversationForm?.querySelector(`[data-error-for="${field}"]`) as HTMLElement;
    if (!errorEl) return;
    errorEl.textContent = message;
  }

  function clearError(field: string) {
    const errorEl = conversationForm?.querySelector(`[data-error-for="${field}"]`) as HTMLElement;
    if (!errorEl) return;
    errorEl.textContent = '';
  }

  function selectedMethod(): 'email' | 'phone' | '' {
    const selected = Array.from(methodInputs).find(input => input.checked);
    return (selected?.value as 'email' | 'phone') || '';
  }

  function updateContactPlaceholder() {
    const method = selectedMethod();
    if (!contactInput) return;
    if (method === 'phone') {
      contactInput.placeholder = 'Enter your phone number';
      return;
    }
    contactInput.placeholder = 'Enter your email address';
  }

  function validateConversationForm() {
    let valid = true;
    clearError('conversation-fullname');
    clearError('communication-method');
    clearError('conversation-contact');

    const fullName = fullNameInput?.value?.trim() || '';
    const contact = contactInput?.value?.trim() || '';
    const method = selectedMethod();

    if (!fullName || fullName.length < 2) {
      setError('conversation-fullname', 'Please enter your full name.');
      valid = false;
    }

    if (!method) {
      setError('communication-method', 'Please choose Email or Phone.');
      valid = false;
    }

    if (!contact) {
      setError('conversation-contact', method === 'phone' ? 'Please enter your phone number.' : 'Please enter your email address.');
      valid = false;
    } else if (method === 'email') {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(contact)) {
        setError('conversation-contact', 'Please enter a valid email address.');
        valid = false;
      }
    } else if (method === 'phone') {
      const phoneRegex = /^[+()\d\s.-]{7,}$/;
      if (!phoneRegex.test(contact)) {
        setError('conversation-contact', 'Please enter a valid phone number.');
        valid = false;
      }
    }

    return valid;
  }

  function openConversationPanel() {
    if (!panel) return;
    closeAiConciergePanel();
    panel.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
    panel.classList.add('translate-x-0', 'opacity-100');
    panel.setAttribute('aria-hidden', 'false');
  }

  function closeConversationPanel() {
    if (!panel) return;
    panel.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
    panel.classList.remove('translate-x-0', 'opacity-100');
    panel.setAttribute('aria-hidden', 'true');
  }

  function openAiConciergePanel() {
    if (!aiPanel) return;
    closeConversationPanel();
    aiPanel.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
    aiPanel.classList.add('translate-x-0', 'opacity-100');
    aiPanel.setAttribute('aria-hidden', 'false');
    aiChatInput?.focus();
  }

  function closeAiConciergePanel() {
    if (!aiPanel) return;
    aiPanel.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
    aiPanel.classList.remove('translate-x-0', 'opacity-100');
    aiPanel.setAttribute('aria-hidden', 'true');
  }

  function updateNav() {
    if (window.scrollY > 80) {
      nav.style.background = 'rgba(6,5,5,0.96)';
      nav.style.backdropFilter = 'blur(12px)';
      (nav.style as any)['-webkit-backdrop-filter'] = 'blur(12px)';
      nav.style.boxShadow = '0 2px 24px rgba(0,0,0,0.4)';
    } else {
      nav.style.background = 'rgba(255,255,255,0.10)';
      nav.style.backdropFilter = 'blur(12px)';
      (nav.style as any)['-webkit-backdrop-filter'] = 'blur(12px)';
      nav.style.boxShadow = 'none';
    }
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  mobileBtn.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    mobileMenu.classList.toggle('flex');
  });

  openConversationButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
      openConversationPanel();
      updateContactPlaceholder();
    });
  });

  panelClose?.addEventListener('click', closeConversationPanel);
  aiClose?.addEventListener('click', closeAiConciergePanel);

  openAiConciergeButtons.forEach(btn => {
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
      openAiConciergePanel();
    });
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeConversationPanel();
      closeAiConciergePanel();
    }
  });

  (window as any).openAIConcierge = openAiConciergePanel;

  aiChatForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = aiChatInput?.value?.trim();
    if (!text || !aiChatThread) return;

    const userRow = document.createElement('div');
    userRow.className = 'ai-row ai-row-user';
    userRow.innerHTML = `<div class="ai-bubble ai-bubble-user"><p>${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p></div>`;
    aiChatThread.appendChild(userRow);

    const botRow = document.createElement('div');
    botRow.className = 'ai-row ai-row-assistant';
    botRow.innerHTML = `<div class="ai-avatar" aria-hidden="true">✦</div><div class="ai-bubble ai-bubble-assistant"><p>Thanks. Our AI Concierge received your message and will guide you to the right practice area.</p></div>`;
    aiChatThread.appendChild(botRow);

    aiChatInput.value = '';
    aiChatThread.scrollTop = aiChatThread.scrollHeight;
  });

  methodInputs.forEach(input => {
    input.addEventListener('change', () => {
      updateContactPlaceholder();
      clearError('communication-method');
      clearError('conversation-contact');
    });
  });

  fullNameInput?.addEventListener('input', () => clearError('conversation-fullname'));
  contactInput?.addEventListener('input', () => clearError('conversation-contact'));

  conversationForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!validateConversationForm()) return;

    if (submitButton) {
      const original = submitButton.textContent;
      submitButton.textContent = 'Message Sent';
      submitButton.disabled = true;
      setTimeout(() => {
        submitButton.textContent = original || 'Send My Message';
        submitButton.disabled = false;
      }, 1800);
    }

    conversationForm.reset();
    messageInput.value = '';
    methodInputs[0] && (methodInputs[0].checked = true);
    updateContactPlaceholder();
  });

  updateContactPlaceholder();

  // Close mobile menu on link click
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
    });
  });
</script>

<style>
  .conversation-panel-content {
    background: rgba(34, 37, 42, 0.42);
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(145, 131, 108, 0.65) rgba(255, 255, 255, 0.08);
  }

  .ai-panel {
    background: rgba(34, 37, 42, 0.42);
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-bottom: 0;
  }

  .ai-panel-header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 32px;
    background: linear-gradient(90deg, #839984 0%, #C4C4C4 100%);
  }

  .ai-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2A2A2A;
    color: #C6B088;
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
  }

  .ai-header-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    font-style: normal;
    color: #060505;
  }

  .ai-title {
    margin: 0;
    font-family: Merriweather, serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
  }

  .ai-subtitle {
    margin: 0;
    font-family: Merriweather, serif;
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
  }

  .ai-close-btn {
    position: absolute;
    top: 12px;
    right: 10px;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .ai-close-line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 1.5px;
    background: #2A2A2A;
    transform-origin: center;
  }

  .ai-close-line-a {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .ai-close-line-b {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .ai-chat-main {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .ai-chat-thread {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    justify-content: flex-end;
    gap: 24px;
    padding: 5px 32px 0;
    overflow-y: auto;
  }

  .ai-row {
    display: flex;
    width: 100%;
  }

  .ai-row-assistant {
    align-items: flex-end;
    gap: 8px;
  }

  .ai-row-user {
    justify-content: flex-end;
    align-items: flex-end;
  }

  .ai-bubble {
    width: 260px;
    max-width: calc(100% - 44px);
    padding: 12px;
  }

  .ai-bubble p {
    margin: 0;
    color: #F4F3F2;
    font-family: Merriweather, serif;
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
  }

  .ai-bubble-assistant {
    border-radius: 8px 8px 8px 0;
    background: linear-gradient(90deg, #849A85 0%, #91836C 100%);
  }

  .ai-bubble-user {
    border-radius: 8px 8px 0 8px;
    background: rgba(244, 243, 242, 0.08);
  }

  .ai-input-wrap {
    padding: 0 32px;
    position: sticky;
    bottom: 0;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding-top: 14px;
    padding-bottom: 16px;
  }

  .ai-input-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    border-radius: 8px;
    border: 1px solid #91836C;
    padding: 16px;
    background: rgba(22, 25, 30, 0.42);
  }

  .ai-input-box input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: #F4F3F2;
    font-family: Merriweather, serif;
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    outline: none;
  }

  .ai-input-box input::placeholder {
    color: #F4F3F2;
    opacity: 1;
  }

  .ai-input-box button {
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 1366px) {
    #ai-concierge-panel {
      width: 390px !important;
      max-width: 390px !important;
    }

    .ai-panel-header {
      padding: 10px 24px;
    }

    .ai-chat-thread {
      gap: 18px;
      padding: 8px 24px 0;
    }

    .ai-bubble {
      width: 236px;
      max-width: calc(100% - 44px);
      padding: 10px;
    }

    .ai-bubble p,
    .ai-input-box input {
      font-size: 18px;
      line-height: 20px;
    }

    .ai-input-wrap {
      padding: 0 24px;
      padding-top: 8px;
    }
  }

  @media (max-height: 900px) {
    .ai-chat-main {
      gap: 12px;
    }

    .ai-chat-thread {
      gap: 12px;
      padding-top: 8px;
    }

    .ai-bubble {
      padding: 9px;
    }

    .ai-bubble p,
    .ai-input-box input {
      font-size: 16px;
      line-height: 18px;
    }

    .ai-input-box {
      padding: 12px;
    }
  }

  @media (max-width: 1024px) {
    #ai-concierge-panel {
      width: 360px !important;
      max-width: 360px !important;
    }

    .ai-panel-header {
      padding: 10px 18px;
      gap: 10px;
    }

    .ai-avatar {
      width: 32px;
      height: 32px;
