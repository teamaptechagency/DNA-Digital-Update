---
const badgeItems = ['SDVOSB Certified', 'Professionally Certified', '30+ Years Experience'];
---

<section id="about-hero" class="about-hero">
  <img
    src="/images/hero-bg.jpg"
    alt=""
    class="about-hero-bg"
    loading="eager"
    decoding="async"
  />
  <div class="about-hero-overlay"></div>

  <div class="about-hero-content section-container">
    <h1>PARTNERSHIPS BUILT ON TRUST. SYSTEMS BUILT ON EXCELLENCE.</h1>

    <p class="hero-subtitle">Engineering Resilience into your Digital Dna</p>

    <div class="hero-badges" aria-label="About credentials badges">
      {badgeItems.map((item, index) => (
        <>
          <span class="badge-label">{item}</span>
          {index < badgeItems.length - 1 ? (
            <span class="badge-pipe" aria-hidden="true">|</span>
          ) : null}
        </>
      ))}
    </div>

    <a href="#" data-open-conversation class="hero-cta">Initiate a Strategic Review</a>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const aboutHero = document.getElementById('about-hero');

  if (aboutHero) {
    const heading = aboutHero.querySelector('h1');
    const subtitle = aboutHero.querySelector('.hero-subtitle');
    const badges = aboutHero.querySelector('.hero-badges');
    const cta = aboutHero.querySelector('.hero-cta');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion) {
      const timeline = gsap.timeline({ delay: 0.3 });

      timeline
        .fromTo(
          heading,
          { opacity: 0, y: 60 },
          { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' }
        )
        .fromTo(
          subtitle,
          { opacity: 0, y: 40 },
          { opacity: 1, y: 0, duration: 1, ease: 'power2.out' },
          '-=0.7'
        )
        .fromTo(
          badges,
          { opacity: 0, y: 35 },
          { opacity: 0.5, y: 0, duration: 0.9, ease: 'power2.out' },
          '-=0.6'
        )
        .fromTo(
          cta,
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
          '-=0.5'
        );
    }
  }
</script>

<style>
  .about-hero {
    position: relative;
    width: 100%;
    min-height: 720px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #060505;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(6, 5, 5, 0.56);
  }

  .about-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-top: 80px;
    padding-bottom: 30px;
  }

  @media (min-width: 768px) {
    .about-hero {
      min-height: 670px;
    }

    .about-hero-content {
      padding-top: 160px;
      padding-bottom: 96px;
    }
  }

  .about-hero-content h1 {
    margin: 0;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.06em;
    max-width: 1280px;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .about-hero-content h1 {
      font-size: clamp(42px, 5vw, 72px);
    }
  }

  .hero-subtitle {
    margin: 0;
    max-width: 1088px;
    padding-inline: 96px;
    color: #91836c;
    font-family: 'Merriweather', serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.8;
  }

  .hero-badges {
    margin-top: 24px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    opacity: 0.5;
    flex-wrap: wrap;
  }

  .hero-badges .badge-label {
    color: #e2ded6;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge-pipe {
    color: #e2ded6;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    opacity: 0.9;
  }

  .hero-cta {
    margin-top: 8px;
    width: 360px;
    max-width: calc(100vw - 48px);
    border-radius: 6px;
    background: rgba(145, 131, 108, 0.4);
    padding: 16px 20px;
    color: #fff;
    text-align: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    transition: transform 1s ease, background-color 1s ease;
  }

  .hero-cta:hover {
    transform: translateY(-3px);
    background: rgba(145, 131, 108, 0.54);
  }

  @media (max-width: 1024px) {
    .hero-subtitle {
      padding-inline: 28px;
    }
  }

  @media (max-width: 768px) {
    .about-hero-content {
      gap: 16px;
    }

    .about-hero-content h1 {
      letter-spacing: -0.03em;
    }

    .hero-subtitle {
      font-size: 17px;
      line-height: 1.5;
      padding-inline: 0;
    }

    .hero-badges {
      margin-top: 8px;
      gap: 10px;
    }

    .hero-badges .badge-label,
    .badge-pipe {
      font-size: 12px;
    }

    .hero-cta {
      margin-top: 0;
      font-size: 14px;
      padding: 14px 18px;
    }
  }
</style>
