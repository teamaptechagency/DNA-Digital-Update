---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PracticeDirectory from '../components/PracticeDirectory.astro';
import ClientPartners from '../components/ClientPartners.astro';
import OurPhilosophy from '../components/OurPhilosophy.astro';
import OurExpertise from '../components/OurExpertise.astro';
import OurDifference from '../components/OurDifference.astro';
import ScrollPlates from '../components/ScrollPlates.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="DNA Digital Consultancy | Strategy. Execution. Transformation.">
  <script is:inline>
    (() => {
      const navigationEntry = performance.getEntriesByType('navigation')[0];
      const isReload = navigationEntry
        ? navigationEntry.type === 'reload'
        : performance.navigation?.type === 1;

      if (!isReload) return;

      history.scrollRestoration = 'manual';

      if (window.location.hash) {
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
      }

      const returnToHero = () => window.scrollTo(0, 0);

      returnToHero();
      window.addEventListener('pageshow', () => {
        window.requestAnimationFrame(returnToHero);
      }, { once: true });
    })();
  </script>
  <Nav />
  <main>
    <Hero />
    <PracticeDirectory />
    <ClientPartners />
    <OurPhilosophy />
    <OurExpertise />
    <OurDifference />
    <ScrollPlates />
  </main>
  <Footer />
</Layout>
