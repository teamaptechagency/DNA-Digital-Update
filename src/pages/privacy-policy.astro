---
import Layout from '../layouts/Layout.astro';
import LegalSections from '../components/LegalSections.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const sections = [
  {
    "num": "1.",
    "title": "INTRODUCTION",
    "blocks": [
      {
        "type": "paragraph",
        "text": "DNA Digital Consultancy (“we,” “us,” or “our”), a DBA of Dna Web Solutions, Inc., is committed to protecting your privacy. This Privacy Policy explains how we collect, use, and safeguard your information when you visit our website or engage our professional services. We operate with a military-grade commitment to accountability; we do exactly what we say we’ll do, especially when it comes to your data security."
      }
    ]
  },
  {
    "num": "2.",
    "title": "INFORMATION WE COLLECT",
    "blocks": [
      {
        "type": "paragraph",
        "text": "We collect information that allows us to deliver high-performance consulting and technical solutions. This falls into two categories:"
      },
      {
        "type": "bullet",
        "text": "Voluntary Information: This includes names, email addresses, phone numbers, SMS opt-in consent records, and project details provided via our “Start the Conversation” contact forms, inquiry submissions, or consultation bookings."
      },
      {
        "type": "bullet",
        "text": "Technical Data: We automatically collect IP addresses, browser types, and usage patterns via cookies to optimize the performance of our digital experience."
      }
    ]
  },
  {
    "num": "3.",
    "title": "HOW WE USE YOUR DATA",
    "blocks": [
      {
        "type": "paragraph",
        "text": "Your data is the blueprint for our engagement. We use it strictly to:"
      },
      {
        "type": "bullet",
        "text": "Facilitate strategic AI roadmapping and technology leadership."
      },
      {
        "type": "bullet",
        "text": "Develop and deploy custom software, mobile apps, and CRM intelligence."
      },
      {
        "type": "bullet",
        "text": "Communicate project milestones, inquiry responses, and delivery enablement."
      },
      {
        "type": "bullet",
        "text": "Ensure the security and resilience of our digital infrastructure."
      }
    ]
  },
  {
    "num": "4.",
    "title": "DATA SHARING & THIRD PARTIES",
    "blocks": [
      {
        "type": "paragraph",
        "text": "We do not measure success by the size of our database, and we certainly do not sell it. Data is only shared with third-party service providers (such as AWS for cloud hosting or GoHighLevel for CRM platform management) strictly when essential to execute the mission you have hired us to perform. All partners are vetted for proactive risk anticipation and high-performance integrity."
      },
      {
        "type": "paragraph",
        "text": "Mobile Information & SMS Consent Non-Sharing Clause:"
      },
      {
        "type": "paragraph",
        "text": "No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. All the above categories exclude text messaging originator opt-in data and consent; this information will not be shared with any third parties under any circumstances."
      }
    ]
  },
  {
    "num": "5.",
    "title": "SMS & MOBILE COMMUNICATIONS",
    "blocks": [
      {
        "type": "paragraph",
        "text": "When you provide your phone number through our website contact forms and check the SMS consent box, you consent to receive text messages from DNA Digital Consultancy regarding your inquiry, scheduled consultations, or active projects."
      },
      {
        "type": "bullet",
        "text": "Voluntary Consent: Opting in to SMS is entirely voluntary and is not required as a condition of purchasing any consulting or development services."
      },
      {
        "type": "bullet",
        "text": "Opt-Out Mechanics: You may opt out of SMS communications at any time by replying “STOP” to any text message received. After replying “STOP,” we will send one final SMS confirming your unsubscription."
      },
      {
        "type": "bullet",
        "text": "Help & Support: If you experience issues or need assistance, reply “HELP” to any message or contact us at hello@dnadigitalconsultancy.ai."
      },
      {
        "type": "bullet",
        "text": "Message Frequency & Rates: Message frequency varies depending on your interactions with us. Standard message and data rates may apply according to your cellular carrier plan."
      }
    ]
  },
  {
    "num": "6.",
    "title": "YOUR DATA RIGHTS",
    "blocks": [
      {
        "type": "paragraph",
        "text": "YOUR RIGHT TO ACCESS: You have the right to request a copy of the personal data we hold about you. You may also request that we correct, delete, or restrict the processing of your information at any time."
      }
    ]
  },
  {
    "num": "7.",
    "title": "COOKIES & TRACKING",
    "blocks": [
      {
        "type": "paragraph",
        "text": "We use functional and analytical cookies to ensure our website’s glassmorphism and motion effects perform at peak efficiency. You can manage these at any time via our Cookie Preferences dashboard."
      }
    ]
  },
  {
    "num": "8.",
    "title": "DATA SECURITY",
    "blocks": [
      {
        "type": "paragraph",
        "text": "Integrity is our operating system. We implement industry-standard technical and organizational measures—including hardware cold storage for digital assets when applicable—to protect your information from unauthorized access or structural failure."
      }
    ]
  },
  {
    "num": "9.",
    "title": "CONTACT US",
    "blocks": [
      {
        "type": "paragraph",
        "text": "If you have questions regarding this policy or our data practices, please contact us at:"
      },
      {
        "type": "paragraph",
        "text": "DNA Digital Consultancy"
      },
      {
        "type": "paragraph",
        "text": "Signal Hill, California"
      },
      {
        "type": "paragraph",
        "text": "Email: hello@dnadigitalconsultancy.ai"
      }
    ]
  }
];
---

<Layout
  title="Privacy Policy | DNA Digital Consultancy"
  description="Privacy Policy for DNA Digital Consultancy — how we collect, use, and protect your data."
>
  <Nav />
  <main class="legal-page legal-privacy-page">

    <!-- HERO -->
    <section
      class="legal-hero relative w-full overflow-hidden flex items-center justify-center"
      style="height: 440px; background-color: #060505;"
    >
      <!-- Background image -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero-bg.jpg"
          alt=""
          class="w-full h-full object-cover object-center"
          style="filter: brightness(0.45) saturate(0.6) contrast(1.1);"
        />
        <div
          class="absolute inset-0"
        ></div>
      </div>

      <!-- Hero Text -->
      <div class="legal-hero-text relative z-10 text-center px-8 pt-24">
        <h1
          class="font-montserrat font-semibold text-white mb-4"
          style="font-size: 72px; line-height: 1.2; letter-spacing: -0.04em;"
        >
          PRIVACY POLICY
        </h1>
        <p
          class="font-merriweather font-medium"
          style="font-size: 20px; line-height: 36px; color: #91836C;"
        >
          Last Updated: October 06, 2026
        </p>
      </div>
    </section>

    <!-- CONTENT BODY -->
    <section class="legal-content w-full py-[144px]" style="background-color: #FDFCF6;">

      <div class="section-container">
        <div class="mx-auto" style="max-width: 900px;">
          <div class="flex flex-col" style="gap: 96px;">

            <LegalSections sections={sections} />

          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  @media (max-width: 768px) {
    .legal-privacy-page .legal-hero {
      height: 400px !important;
    }

    .legal-privacy-page .legal-hero-text {
      padding: 0 20px !important;
      transform: translateY(42px);
    }

    .legal-privacy-page .legal-hero-text h1 {
      font-size: 40px !important;
      line-height: 48px !important;
      letter-spacing: -0.06em !important;
      margin-bottom: 28px !important;
    }

    .legal-privacy-page .legal-hero-text p {
      font-size: 16px !important;
      line-height: 27.2px !important;
    }

    .legal-privacy-page .legal-content {
      padding-top: 80px !important;
      padding-bottom: 80px !important;
    }

    .legal-privacy-page .legal-content .mx-auto > .flex.flex-col {
      gap: 40px !important;
    }

    .legal-privacy-page .legal-content [style*='font-size: 28px'] {
      font-size: 20px !important;
      line-height: 34px !important;
    }

    .legal-privacy-page .legal-section-heading {
      align-items: flex-start;
    }

    .legal-privacy-page .legal-section-number {
      flex: 0 0 26px;
      text-align: left;
    }
  }
</style>
